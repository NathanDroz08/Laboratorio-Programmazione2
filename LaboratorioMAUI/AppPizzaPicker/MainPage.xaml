<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppPizzaPicker.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Menu Pizze"
                HorizontalOptions="Center"
                FontSize="42"/>

            <Label
                Text="Seleziona tipo di pizza"/>

            <Picker x:Name="pickPizze"
                    Title="Scegli la pizza"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedIndexChanged="pickPizze_SelectedIndexChanged"
                    />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
